{
  "name": "gem-viz",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite dev",
    "prefetch:api": "node scripts/prefetch-data.js",
    "prefetch:api:resume": "node scripts/prefetch-data.js --resume",
    "build": "node scripts/inject-version.js && node scripts/generate-geojson.js && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:full": "npm run prefetch:api && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.js",
    "deploy:full": "npm run prefetch:api && npm run deploy",
    "release": "node scripts/release.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{js,ts,svelte,css,html}'",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run lint && npm run format && npm run type-check",
    "geojson": "node scripts/generate-geojson.js",
    "spot-check": "node scripts/spot-check.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-cloudflare": "^7.2.6",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@tsconfig/svelte": "^5.0.6",
    "@types/chroma-js": "^3.1.2",
    "@types/dagre": "^0.7.53",
    "@types/dagre-d3": "^0.6.6",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.5",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-minify": "^2.1.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.2",
    "@deck.gl/core": "^9.2.2",
    "@deck.gl/layers": "^9.2.2",
    "@luma.gl/core": "^9.2.4",
    "@luma.gl/webgl": "^9.2.4",
    "animejs": "^4.2.2",
    "chroma-js": "^3.2.0",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "dagre": "^0.8.5",
    "dagre-d3": "^0.6.4",
    "dotenv": "^17.2.3",
    "isomorphic-dompurify": "^2.34.0",
    "lucide-svelte": "^0.576.0",
    "maplibre-gl": "^5.12.0",
    "maplibre-gl-draw": "^1.6.9",
    "marked": "^17.0.1",
    "slugify": "^1.6.6"
  }
}
