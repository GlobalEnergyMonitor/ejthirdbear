# GEM Viz
#
# FIRST TIME:    just setup
# DEVELOPING:    just dev
# DEPLOYING:     just ship      (see DEPLOY.md for credentials)

default:
  @just --list

# ─────────────────────────────────────────────────────────────────────────
# MAIN WORKFLOWS
# ─────────────────────────────────────────────────────────────────────────

# First-time setup
setup: install
  @echo "✓ Run 'just dev' to start"

# Start dev server
dev:
  npm run dev

# Deploy to production
ship: build deploy
  @echo "✓ Deployed!"

# ─────────────────────────────────────────────────────────────────────────
# BUILD
# ─────────────────────────────────────────────────────────────────────────

build:
  npm run build

preview:
  npm run preview

clean:
  rm -rf .svelte-kit build

# ─────────────────────────────────────────────────────────────────────────
# DEPLOY
# ─────────────────────────────────────────────────────────────────────────

# Deploy to Digital Ocean Spaces (see DEPLOY.md for setup)
deploy:
  npm run deploy

# ─────────────────────────────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────────────────────────────

install:
  npm install

check:
  npm run check

lint:
  npm run lint

format:
  npm run format

release:
  npm run release
